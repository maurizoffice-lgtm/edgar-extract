# Secrets — never commit
.env
.env.*
!.env.example

# Download / API cache (can be rebuilt; may be large)
data/cache/*
!data/cache/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/

# Editors / OS
.DS_Store
.idea/
.vscode/

# Local SQLite database (rebuilt by the scripts). Only the public dashboard copy is committed.
data/*.db
!data/dashboard.db

# Extracted financial sections (rebuilt by edgar_extract.preprocess)
data/processed/

# Local Claude Code / editor settings
.claude/
